[Unit]
Description=RL SAR D1 joystick and LoRa start trigger
After=multi-user.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/navbot/project/d1_rl_sar/rl_sar
Environment=RCUTILS_LOGGING_BUFFERED_STREAM=1
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source /home/navbot/project/d1_rl_sar/rl_sar/install/setup.bash && exec ros2 run rl_sar rl_real_d1_trigger --joy-device /dev/input/js0 --joy-button 3 --dog-usb-device /dev/ttyTHS1 --dog-usb-baud 115200 --dog-usb-l1-button-bit 8 --main-service rl-sar-main.service'
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
