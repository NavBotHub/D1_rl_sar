[Unit]
Description=RL SAR D1 main ROS2 control launch
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=/root
Environment=ROS_HOME=/var/lib/rl-sar/ros
Environment=ROS_LOG_DIR=/var/log/rl-sar/ros
Environment=RCUTILS_LOGGING_BUFFERED_STREAM=1
EnvironmentFile=/etc/default/rl-sar
ExecStartPre=/bin/mkdir -p /var/lib/rl-sar/ros /var/log/rl-sar/ros
ExecStart=/bin/bash -lc 'cd "${RL_SAR_ROOT}" && source /opt/ros/humble/setup.bash && source "${RL_SAR_ROOT}/install/setup.bash" && exec ros2 launch rl_sar rl_real_d1_headless.launch.py dog_usb_enable:=true dog_usb_device:=/dev/ttyTHS1 dog_usb_baud:=115200 dog_usb_timeout_ms:=300 dog_remote_timeout_ms:=1500 dog_usb_allow_fallback:=false dog_usb_l1_off_exit:=true dog_usb_l1_button_bit:=8 dog_usb_l1_exit_timeout_ms:=8000 keyboard_enable:=false sys_joystick_device:=/dev/input/js0'
KillSignal=SIGINT
TimeoutStopSec=10
Restart=no

[Install]
WantedBy=multi-user.target
